{
  "info": {
    "name": "Skill Sharing Platform - Complete API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "http://localhost:5001/users"
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "http://localhost:5001/users/login"
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:5001/users/me"
          }
        }
      ]
    },
    {
      "name": "Skills",
      "item": [
        {
          "name": "Create Skill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Coding in React\",\n  \"description\": \"Learn the basics of React.js components.\",\n  \"category\": \"Programming\",\n  \"image\": \"https://images.unsplash.com/photo-1633356122544-f134324a6cee\",\n  \"videoUrl\": \"https://youtube.com/watch?v=dQw4w9WgXcQ\"\n}"
            },
            "url": "http://localhost:5001/skills"
          }
        },
        {
          "name": "Get All Skills",
          "request": {
            "method": "GET",
            "url": "http://localhost:5001/skills"
          }
        },
        {
          "name": "Get Trending Skills",
          "request": {
            "method": "GET",
            "url": "http://localhost:5001/skills/trending"
          }
        },
        {
          "name": "Update Skill",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Skill Title\",\n  \"description\": \"Updated description here.\"\n}"
            },
            "url": "http://localhost:5001/skills/{{skill_id}}"
          }
        },
        {
          "name": "Delete Skill",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:5001/skills/{{skill_id}}"
          }
        },
        {
          "name": "Like Skill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "http://localhost:5001/skills/{{skill_id}}/like"
          }
        },
        {
          "name": "Comment on Skill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"This is an amazing tutorial! Thanks for sharing.\"\n}"
            },
            "url": "http://localhost:5001/skills/{{skill_id}}/comment"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "http://localhost:5001/notifications"
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": "YOUR_JWT_TOKEN_HERE"
    },
    {
      "key": "skill_id",
      "value": "SKILL_ID_HERE"
    }
  ]
}

